# ===== Telegram =====
BOT_TOKEN=123456:ABC-DEF...
CHANNEL=@steam_skidki
CHANNEL_TITLE=STEAM | СКИДКИ
# Telegram ID владельца (для команд /status /sync /post /emoji_id).
# ВАЖНО: пока здесь 0, админ-команды заблокированы для всех.
OWNER_ID=0
# Чат обсуждений канала (супергруппа). 0 = автоопределение по типу чата
DISCUSS_CHAT_ID=0

# ===== Steam =====
# 0 = качать все скидки (~170 страниц), либо лимит страниц (100 игр каждая)
MAX_SEARCH_PAGES=80
MIN_DISCOUNT=15
STEAM_DELAY=0.4
# Минимальный вес игры (отзывы+скидка) ТОЛЬКО для порядка очереди.
# 0 = в пуле все игры со скидками, сортировка лишь ставит известные вперёд.
MIN_SCORE=0

# ===== Постинг =====
TIMEZONE_OFFSET=3
POST_DELAY=10
# премиум-эмодзи Telegram (1 = вкл, 0 = обычные эмодзи)
PREMIUM_EMOJI=1
# свои проверенные emoji-id: узнайте через команду /emoji_id в личке бота
# CUSTOM_EMOJI_MAP=fire=5368324170671202286,gem=5312411081962852416
CUSTOM_EMOJI_MAP=
# лимит длины подписи (Telegram max 1024)
CAPTION_LIMIT=1000
# Проверка каталога скидок каждые N часов (4 = 6 раз в сутки)
SYNC_HOURS=4

# ===== Расписание (MSK) =====
# kinds: single | multi | series | roundup | ending | under300 | freebie
# freebie (100%) публикуется автоматически сразу после sync, вне расписания
SCHEDULE=10:00 roundup, 12:00 releases, 13:00 single, 15:00 under300, 18:00 multi, 20:00 ending, 22:00 single
